# ======================================================
# FamilyTree Clean v1.0 - Backend Environment
# ======================================================

# Railway MySQL
# On Railway, connect these as Reference Variables
# from the MySQL service. Do not copy database passwords manually.
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# Required - unique for each FamilyTree deployment
SECRET_KEY=

# Production configuration
ENV=production
FRONTEND_URL=

# Used in backup filenames, for example: TocLe, TocNguyen
FAMILY_CODE=FamilyTree

# Required only during the first setup.
# Delete this variable from Railway after setup is completed.
SETUP_TOKEN=
